{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "apps/web/api/**/*.ts", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/auth/google", "dest": "/apps/web/api/auth/google.ts" },
    { "src": "/api/auth/google-callback", "dest": "/apps/web/api/auth/google-callback.ts" }
  ]
}
