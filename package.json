{
  "name": "whatsapp-assistant",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev:bot": "pnpm --filter @wa/bot dev",
    "db:generate": "pnpm --filter @wa/core db:generate",
    "db:migrate": "pnpm --filter @wa/core db:migrate"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
