# --- Database (Supabase pooler, SESSION mode — port 5432, not 6543) ---
DATABASE_URL=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM (agent loop) ---
OPENAI_API_KEY=

# --- Voice transcription ---
GROQ_API_KEY=

# --- Google OAuth (Phase 2) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=     # https://<vercel-app>/api/auth/google-callback
WEB_PUBLIC_URL=          # https://<vercel-app>  (base of the Vercel OAuth app; used by connect_google)

# --- Ops ---
BOT_PUBLIC_URL=
ALLOWED_PHONES=

# --- Phase 1 tuning (optional; defaults shown) ---
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=whisper-large-v3
BAILEYS_SESSION_ID=default
SUPABASE_STORAGE_BUCKET=user-files
PORT=3000
